# Copy to .env.local (not committed) and fill in.
# MapTiler client key: https://cloud.maptiler.com/account/keys/ . Restrict it to your domains in MapTiler.
MAPTILER_API_KEY=
# Optional: where Field answers join links (the QR code and link in a mission). Defaults to the app scheme trace-field://.
# VITE_JOIN_LINK_BASE=https://trace.app
# Optional error tracking (Sentry, project "trace-command"). Off without a DSN. The DSN is public by design: it only
# lets a browser send events. See docs/MONITORING.md.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=trace-command@0.1.0
# Source maps are uploaded by the build only when SENTRY_AUTH_TOKEN is set in the build environment (with SENTRY_ORG).
# The token is a secret: never put it in this file.
# Optional: SHA-256 fingerprint(s) of the Field APK's signing certificate, comma-separated. When set, the build writes
# /.well-known/assetlinks.json so Android opens join links in Field (docs/DEPLOYMENT.md).
# ANDROID_CERT_SHA256=AA:BB:...
