# Optional: copy to .env and change. Defaults match docker-compose.yml.
# DATABASE_URL=postgres://trace:trace@localhost:5433/trace
# TEST_DATABASE_URL=postgres://trace:trace@localhost:5433/trace_test
# Required in production. AUTH_SECRET signs sessions: at least 32 random characters (openssl rand -base64 32).
# API_URL=http://localhost:3001
# AUTH_SECRET=
# Set to true behind a reverse proxy (Railway): the client address is then read from X-Forwarded-For. Keep false otherwise.
# TRUST_PROXY=false
# Log level: fatal, error, warn, info, debug, trace or silent. Defaults to info in production, debug in development.
# LOG_LEVEL=info
# Error tracking (Sentry, project "trace-api"). Off without a DSN. See docs/MONITORING.md.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=trace-api@0.1.0
# SENTRY_TRACES_SAMPLE_RATE=0.05
# Log shipping to Grafana Cloud Loki. Set all three or none. Use a token with the logs:write scope only.
# LOKI_URL=https://logs-prod-000.grafana.net
# LOKI_USER=
# LOKI_TOKEN=
