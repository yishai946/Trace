# Copy to .env.local (not committed) and fill in. Expo inlines EXPO_PUBLIC_ variables into the app: never put secrets here.
# The TRACE API, as the phone reaches it (your computer's LAN address in development, not localhost).
EXPO_PUBLIC_API_URL=
# MapTiler client key: https://cloud.maptiler.com/account/keys/ . Restrict it to the app in MapTiler.
EXPO_PUBLIC_MAPTILER_API_KEY=
