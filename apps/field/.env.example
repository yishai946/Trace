# Copy to .env.local (not committed) and fill in. Expo inlines EXPO_PUBLIC_ variables into the app: never put secrets here.
# The TRACE API, as the phone reaches it (your computer's LAN address in development, not localhost).
EXPO_PUBLIC_API_URL=
# MapTiler client key: https://cloud.maptiler.com/account/keys/ . Restrict it to the app in MapTiler.
EXPO_PUBLIC_MAPTILER_API_KEY=
# Optional error tracking (Sentry, project "trace-field"). Off without a DSN. The DSN is public by design: it only lets
# the app send events. The auth token for source maps is a secret and is never set here (EAS secret SENTRY_AUTH_TOKEN,
# see docs/MONITORING.md).
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=production

# GPS margin in meters near the polygon border for the local out-of-polygon warning (UC-S04). Optional; no default
# (TBD in the spec), empty means the exact boundary. Keep it equal to the API OUT_OF_POLYGON_TOLERANCE_METERS.
EXPO_PUBLIC_OUT_OF_POLYGON_TOLERANCE_METERS=
